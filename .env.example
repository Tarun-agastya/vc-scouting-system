# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=scoutpass123
DATABASE_URL=postgresql://scout:scoutpass123@localhost:5432/vc_scouting

# ── Vector Database ───────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── Ollama / LLM ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REASON_MODEL=qwen3:14b

# ── Discord Bot ───────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ── Gmail Integration (optional) ─────────────────────────────────────────────
GMAIL_CREDENTIALS_PATH=./credentials/gmail_credentials.json

# ── Tavily (web verification search backend, Phase W; optional — falls back
#    to self-hosted SearXNG, then a DuckDuckGo scrape, if unset) ───────────
# Sign up free at https://app.tavily.com — 1,000 queries/month, no card required.
# That monthly quota is shared across EVERY caller of ingestion/web_search.py
# (regional enrichment, web-verify, recheck...) — a single large batch can
# exhaust it before the month resets. SEARXNG_URL below is the free fallback
# with no such limit.
TAVILY_API_KEY=your_tavily_api_key_here

# ── SearXNG (self-hosted free search fallback, 11 Aug 2026) ────────────────
# Runs via `docker compose up -d searxng` — no API key needed, no quota.
# Default matches docker-compose.yml's port mapping; only change this if you
# remap the port or point at a different SearXNG instance.
SEARXNG_URL=http://localhost:8888

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
